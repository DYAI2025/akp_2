{
  "name": "akp-architekten-railway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "preview": "npm run start",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:content": "tsx scripts/test-content.tsx",
    "test:railway": "tsx scripts/test-railway-config.ts",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "test": "npm run lint && npm run test:content && npm run test:railway",
    "ci": "npm run test && npm run build && npm run smoke:preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
