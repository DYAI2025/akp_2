{
  "name": "akp-architekten-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0",
    "start": "node server/index.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --test scripts/verify-content.mjs",
    "test:frontend": "node --test scripts/verify-frontend.mjs",
    "test:smoke": "node --test scripts/smoke-server.mjs",
    "ci": "npm run lint && npm test && npm run test:frontend && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": "22.x"
  }
}
